{
  "name": "slotmachine",
  "version": "2025.10.18-8",
  "description": "華谷電機三格照片拉霸機",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder -c.directories.output=release"
  },
  "author": "華谷電機機工課雷射組 副組長 李書宏 (Tony)",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "Slot Machine.v2",
    "productName": "華谷電機三格照片拉霸機",
    "copyright": "© 2025 華谷電機雷射組",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "files": [
      "**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "華谷電機三格照片拉霸機"
    }
  }
}
